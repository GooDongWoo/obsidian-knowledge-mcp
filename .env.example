# Obsidian Knowledge MCP Local Configuration Template
# Copy this file to .env and configure your personal paths.

# Path to your Obsidian Vault root directory (Required)
# Forward slashes (/) are recommended to avoid escape character issues on Windows.
KNOWLEDGE_VAULT_ROOT="C:/Path/To/Your/Obsidian"

# Path to this project root directory (Required)
KNOWLEDGE_PROJECT_ROOT="C:/Path/To/obsidian-knowledge-mcp"

# (Optional) Qdrant Storage path inside Vault (Defaults to ${KNOWLEDGE_VAULT_ROOT}/.knowledge/qdrant)
# KNOWLEDGE_QDRANT_STORAGE="C:/Path/To/Your/Obsidian/.knowledge/qdrant"

# (Optional) Qdrant Local Service URL (Defaults to http://127.0.0.1:6333)
KNOWLEDGE_QDRANT_URL="http://127.0.0.1:6333"

# (Optional) Dense embedding model name (Defaults to dragonkue/BGE-m3-ko)
KNOWLEDGE_DENSE_MODEL="dragonkue/BGE-m3-ko"

# (Optional) Qdrant Collection name (Defaults to obsidian_knowledge_bge_m3_ko_v1)
KNOWLEDGE_COLLECTION="obsidian_knowledge_bge_m3_ko_v1"

# (Optional) Additional private ignore patterns (separated by semicolon, comma, or newline)
# KNOWLEDGE_EXTRA_IGNORES="Private/**;Personal/**"
