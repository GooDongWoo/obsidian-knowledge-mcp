# Obsidian Knowledge MCP Local Configuration Template
# Copy this file to .env and configure your personal paths.

# Path to your Obsidian Vault root directory (Required)
# Forward slashes (/) are recommended to avoid escape character issues on Windows.
KNOWLEDGE_VAULT_ROOT="C:/Path/To/Your/Obsidian"

# Path to this project root directory (Required)
KNOWLEDGE_PROJECT_ROOT="C:/Path/To/obsidian-knowledge-mcp"

# (Optional) Qdrant Storage path inside the project (Defaults to ${KNOWLEDGE_PROJECT_ROOT}/.knowledge/qdrant)
# KNOWLEDGE_QDRANT_STORAGE="C:/Path/To/obsidian-knowledge-mcp/.knowledge/qdrant"

# (Optional) Qdrant Local Service URL (Defaults to http://127.0.0.1:6333)
KNOWLEDGE_QDRANT_URL="http://127.0.0.1:6333"

# (Optional) Dense embedding model name (Defaults to dragonkue/BGE-m3-ko)
KNOWLEDGE_DENSE_MODEL="dragonkue/BGE-m3-ko"

# PyTorch embedding/reranker inference: batch range 1..256; threads >= 1,
# clamped to host CPU count. Restart the daemon after changing these settings.
KNOWLEDGE_EMBEDDING_BATCH_SIZE=8
KNOWLEDGE_RERANKER_BATCH_SIZE=8
KNOWLEDGE_CPU_THREADS=4
# Optional process CUDA allocator budget, (0, 1]; unset uses PyTorch's default.
# This is not a total GPU memory quota. Models/other processes still need VRAM.
# KNOWLEDGE_CUDA_MEMORY_FRACTION=0.24

# Retained FastEmbed/ONNX provider only; these do not affect default BGE/PyTorch.
# CUDA arena bytes >= 1; unset leaves ONNX Runtime's default memory limit.
# KNOWLEDGE_ONNX_GPU_MEM_LIMIT=268435456
KNOWLEDGE_ONNX_ARENA_EXTEND_STRATEGY=kSameAsRequested
KNOWLEDGE_ONNX_INTRA_OP_NUM_THREADS=4

# (Optional) Qdrant Collection name (Defaults to obsidian_knowledge_bge_m3_ko_v1)
KNOWLEDGE_COLLECTION="obsidian_knowledge_bge_m3_ko_v1"

# Local protocol server policy (loaded before FastMCP is imported)
FASTMCP_CHECK_FOR_UPDATES=off
FASTMCP_TELEMETRY_MODE=off
FASTMCP_SHOW_SERVER_BANNER=false
FASTMCP_DEPRECATION_WARNINGS=true
KNOWLEDGE_DAEMON_START_TIMEOUT=900

# Payload-free query metrics: maximum age (days) and row count. Invalid/zero
# values use defaults; manifests and durable index status are preserved.
KNOWLEDGE_QUERY_RETENTION_DAYS=30
KNOWLEDGE_QUERY_MAX_ROWS=10000

# Historical index runs: latest status per collection is always kept.
KNOWLEDGE_INDEX_RETENTION_DAYS=30
KNOWLEDGE_INDEX_MAX_ROWS=1000

# Rotating daemon event log: 1 MiB active file plus 3 backup files.
KNOWLEDGE_DAEMON_LOG_MAX_BYTES=1048576
KNOWLEDGE_DAEMON_LOG_BACKUP_COUNT=3

# (Optional) Additional private ignore patterns (separated by semicolon, comma, or newline)
# KNOWLEDGE_EXTRA_IGNORES="Private/**;Personal/**"
